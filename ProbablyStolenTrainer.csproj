<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <ManagedDirectory>$(GameDirectory)\Probably Stolen_Data\Managed</ManagedDirectory>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <GameAssembly Include="Assembly-CSharp;UnityEngine.CoreModule;UnityEngine.IMGUIModule;UnityEngine.InputLegacyModule" />
    <Reference Include="@(GameAssembly)">
      <HintPath>$(ManagedDirectory)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckGameDirectory" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GameDirectory)' == '' Or !Exists('$(ManagedDirectory)\Assembly-CSharp.dll')"
           Text="Gib mit -p:GameDirectory=... den Spielordner an. / Set the game folder with -p:GameDirectory=..." />
  </Target>
</Project>
